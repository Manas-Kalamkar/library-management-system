{
  "name": "library-management-system",
  "version": "1.0.0",
  "description": "Library management system REST API (Express 5, Prisma, PostgreSQL, JWT auth)",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
