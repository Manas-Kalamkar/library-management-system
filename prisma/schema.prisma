// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BORROWER
  LIBRARIAN
}

model Session {
  id        String   @id @default(cuid())
  sid       String   @unique
  data      String
  createAt  DateTime @default(now())
  expiresAt DateTime

  userId    String?
  user      User?     @relation(fields: [userId], references: [id],onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model User {
  id        String   @id @default(cuid())
  userName  String
  email     String   @unique
  password  String
  role      Role     @default(BORROWER)
  createAt  DateTime @default(now()) 

  sessions   Session[]
  borrowers  Borrower?
  librarians Librarian?
}

model Author {
  id        String @id @default(cuid())
  name      String
  birthYear Int
  books     Book[] @relation("Authors")

  @@unique([name, birthYear])
}

model Book {
  id            String  @id @default(cuid())
  title         String
  genre         String
  publishedYear Int
  available     Boolean

  authorId String
  author   Author? @relation("Authors", fields: [authorId], references: [id], onDelete: Restrict)

  borrowing Borrowing[]

  @@unique([title, authorId])
}

model Librarian {
  id          String @id @default(cuid())
  userId      String @unique
  name        String
  salary      Int
  joiningYear Int

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  borrowings Borrowing[]

}

model Borrower {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String 
  joiningDate DateTime
  phoneNo     String

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  borrowings Borrowing[]
}

model Borrowing {
  id          String @id @default(cuid())
  bookId      String
  borrowerId  String
  librarianId String

  borrowedAt DateTime  @default(now())
  dueDate    DateTime
  returnedAt DateTime?

  book      Book      @relation(fields: [bookId], references: [id],onDelete: Restrict)
  borrower  Borrower  @relation(fields: [borrowerId], references: [id],onDelete: Restrict)
  librarian Librarian @relation(fields: [librarianId], references: [id],onDelete: Restrict)

  @@index([bookId])
  @@index([borrowerId])
  @@index([librarianId])
}
